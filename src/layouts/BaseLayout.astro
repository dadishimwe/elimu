---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  activeNav?: string;
  noindex?: boolean;
}

const { title, description, activeNav, noindex = false } = Astro.props;
const siteName = 'Elimu Africa';
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const configuredOrigin = import.meta.env.PUBLIC_SITE_URL?.trim();
let canonical: string | undefined;
let socialImage: string | undefined;
if (configuredOrigin) {
  try {
    const origin = new URL(configuredOrigin);
    if (origin.protocol === 'https:' && !origin.username && !origin.password && origin.pathname === '/' && !origin.search && !origin.hash) {
      canonical = new URL(Astro.url.pathname, origin).toString();
      socialImage = new URL('/og-image.png', origin).toString();
    }
  } catch {
    canonical = undefined;
  }
}
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Elimu Africa',
  description: 'An Africa-focused infrastructure platform that develops, owns and operates purpose-built student accommodation and education-support infrastructure under PPP and BOOT concessions, in partnership with national and sub-national governments.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kigali',
    addressCountry: 'Rwanda',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E2A35" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:type" content="image/png" />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content="Elimu Africa’s name and student housing infrastructure description on a navy background with abstract architectural linework and its tagline." />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader activeNav={activeNav} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>
