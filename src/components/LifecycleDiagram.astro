---
const stages = [
  { id: 'develop', title: 'Develop', text: 'Constructability and value engineering enter early and are captured in a fixed-price, date-certain turnkey EPC contract.' },
  { id: 'build', title: 'Build', text: 'Cost and schedule risk sit with the EPC contractor, backed by liquidated damages and performance security.' },
  { id: 'operate', title: 'Operate', text: 'Operations include predictive maintenance, contractually enforced KPIs, real-time reporting and global QHSE standards.' },
  { id: 'handback', title: 'Hand back', text: 'At concession end, the asset is handed back in a defined handback condition.' },
];
---
<section class="lifecycle" aria-labelledby="lifecycle-title">
  <div class="lifecycle-intro">
    <span class="eyebrow">Concession lifecycle</span>
    <h2 id="lifecycle-title">Responsibility across the full term</h2>
    <p>Use the arrow keys or select a stage to read the profile's delivery and stewardship approach.</p>
  </div>
  <div class="lifecycle-track" role="tablist" aria-label="Concession lifecycle stages">
    {stages.map((stage, index) => (
      <button class="lifecycle-step" type="button" role="tab" id={`tab-${stage.id}`} aria-selected={index === 0 ? 'true' : 'false'} aria-controls="lifecycle-detail" tabindex={index === 0 ? 0 : -1} data-stage={stage.id}>
        <span class="lifecycle-index">0{index + 1}</span><span class="lifecycle-name">{stage.title}</span>
      </button>
    ))}
  </div>
  <div class="lifecycle-detail" id="lifecycle-detail" role="tabpanel" aria-labelledby="tab-develop" tabindex="0">
    <p><strong>{stages[0].title}</strong> — {stages[0].text}</p>
  </div>
</section>
<script>
  const stages = {
    develop: { title: 'Develop', text: 'Constructability and value engineering enter early and are captured in a fixed-price, date-certain turnkey EPC contract.' },
    build: { title: 'Build', text: 'Cost and schedule risk sit with the EPC contractor, backed by liquidated damages and performance security.' },
    operate: { title: 'Operate', text: 'Operations include predictive maintenance, contractually enforced KPIs, real-time reporting and global QHSE standards.' },
    handback: { title: 'Hand back', text: 'At concession end, the asset is handed back in a defined handback condition.' },
  } as const;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.lifecycle-step'));
  const panel = document.querySelector<HTMLElement>('#lifecycle-detail');
  const selectStage = (selected: HTMLButtonElement) => {
    for (const tab of tabs) {
      const current = tab === selected;
      tab.setAttribute('aria-selected', String(current));
      tab.tabIndex = current ? 0 : -1;
    }
    const key = selected.dataset.stage as keyof typeof stages | undefined;
    const stage = key ? stages[key] : undefined;
    if (panel && stage) {
      panel.setAttribute('aria-labelledby', selected.id);
      const paragraph = document.createElement('p');
      const heading = document.createElement('strong');
      heading.textContent = stage.title;
      paragraph.append(heading, document.createTextNode(` — ${stage.text}`));
      panel.replaceChildren(paragraph);
    }
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectStage(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft' && event.key !== 'Home' && event.key !== 'End') return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
      if (tabs[next]) {
        tabs[next].focus();
        selectStage(tabs[next]);
      }
    });
  });
</script>
