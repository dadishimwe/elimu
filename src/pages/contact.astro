---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CityNetwork from '../components/CityNetwork.astro';

export const prerender = true;
---
<BaseLayout
  title="Contact"
  description="Contact Elimu Africa through the audience-aware enquiry form. Regional presence is Nairobi, Kigali and Johannesburg; the registered office is Kigali, Rwanda."
  activeNav="/contact/"
>
  <section class="page-hero page-hero-compact">
    <div class="page-hero-inner">
      <p class="eyebrow">Contact</p>
      <h1>Start a conversation.</h1>
      <p class="page-intro">Choose the enquiry type that best describes your message. The contact form is the primary route for enquiries.</p>
    </div>
  </section>
  <section class="contact-layout section-wrap">
    <div class="contact-context">
      <div class="context-block">
        <CityNetwork mode="regional" />
      </div>
      <div class="context-block">
        <span class="eyebrow">Registered office</span>
        <h2>Kigali, Rwanda</h2>
      </div>
      <div class="context-block contact-note">
        <span class="eyebrow">What to expect</span>
        <p>The form confirms receipt only after the configured email service accepts your message. If email routing is not yet set up, it will show that the form is unavailable. Please do not include sensitive personal information.</p>
      </div>
    </div>
    <div class="contact-form-wrap">
      <ContactForm />
    </div>
  </section>
  <section class="contact-closing" aria-label="Elimu Africa closing statement">
    <div class="closing-inner">
      <span class="eyebrow">Elimu Africa</span>
      <h2>We don’t just build residences;<br /><em>we build futures.</em></h2>
    </div>
  </section>
</BaseLayout>
