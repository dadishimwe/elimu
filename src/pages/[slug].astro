---
import BaseLayout from '../layouts/BaseLayout.astro';
import PPPDiagram from '../components/PPPDiagram.astro';
import LifecycleDiagram from '../components/LifecycleDiagram.astro';
import CapitalPathwayDiagram from '../components/CapitalPathwayDiagram.astro';
import CityNetwork from '../components/CityNetwork.astro';
import { pages, team, type ContentPage } from '../content/site';

export const prerender = true;

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
interface Props { page: ContentPage }
const { page } = Astro.props;
const activeNav = ['about', 'corporate-philosophy', 'governments', 'investors', 'our-approach', 'team'].includes(page.slug) ? `/${page.slug}/` : '';
const sectionIndex = (index: number) => String(index + 1).padStart(2, '0');
const closings: Record<string, { eyebrow: string; text: string }> = {
  about: { eyebrow: 'Continue reading', text: 'The philosophy beneath the platform.' },
  governments: { eyebrow: 'For Government partners', text: 'Make an enquiry about a public partnership.' },
  investors: { eyebrow: 'For Investor partners', text: 'Make an enquiry about institutional partnership.' },
  'our-approach': { eyebrow: 'Delivery and stewardship', text: 'Make an enquiry about the project lifecycle.' },
  team: { eyebrow: 'Leadership', text: 'Contact Elimu Africa.' },
};
const closing = closings[page.slug];
---
<BaseLayout title={page.title} description={page.description} activeNav={activeNav}>
  <section class:list={['page-hero', 'page-hero-compact', `page-hero--${page.slug}`]}>
    <div class="page-hero-inner">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      {page.intro && <p class="page-intro">{page.intro}</p>}
      {page.slug === 'corporate-philosophy' && (
        <ul class="philosophy-index" aria-label="Corporate philosophy themes">
          <li>Student experience</li><li>Wellbeing</li><li>Community</li><li>Learning</li>
        </ul>
      )}
    </div>
    {page.slug === 'governments' && <PPPDiagram variant="roles" />}
    {page.slug === 'investors' && <CapitalPathwayDiagram />}
    {page.slug === 'our-approach' && <LifecycleDiagram />}
    {page.slug === 'team' && <CityNetwork mode="leadership" />}
  </section>
  {page.slug === 'team' && (
    <section class="team-section section-wrap" aria-label="Elimu Africa leadership">
      <div class="team-hierarchy">
        {team[0] && (
          <article class="team-member team-chair">
            <span class="team-index">01 / Chair</span>
            <h2>{team[0].name}</h2>
            <p class="team-role">{team[0].role}</p>
            <p class="team-city">{team[0].city}</p>
          </article>
        )}
        <div class="team-leadership-list">
        {team.slice(1).map((person, index) => (
          <article class="team-member">
            <span class="team-index">0{index + 2}</span>
            <h2>{person.name}</h2>
            <p class="team-role">{person.role}</p>
            <p class="team-city">{person.city}</p>
          </article>
        ))}
        </div>
      </div>
    </section>
  )}
  {page.sections.length > 0 && (
    <div class="editorial-sections">
      {page.sections.map((section, index) => (
        <section class:list={['editorial-section', `section-${section.type}`, page.slug === 'about' && index === 1 ? 'section-dark' : '']}>
          <div class="section-rail">
            <span class="section-number">{sectionIndex(index)}</span>
            {section.eyebrow && <span class="eyebrow">{section.eyebrow}</span>}
          </div>
          <div class="section-content">
            <h2>{section.title}</h2>
            {section.type === 'prose' && section.text?.map((paragraph) => <p>{paragraph}</p>)}
            {section.type === 'statement' && section.text?.map((paragraph) => <p class="statement-copy">{paragraph}</p>)}
            {(section.type === 'list' || section.type === 'columns') && section.items && (
              <div class:list={['item-list', section.type === 'columns' ? 'item-list-columns' : '']}>
                {section.items.map((item, itemIndex) => (
                  <article class="editorial-item">
                    <span class="item-marker">{String(itemIndex + 1).padStart(2, '0')}</span>
                    <div>
                      <h3>{item.title}</h3>
                      {item.text !== item.title && <p>{item.text}</p>}
                    </div>
                  </article>
                ))}
              </div>
            )}
            {section.type === 'values' && section.items && (
              <dl class="commitment-list">
                {section.items.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
              </dl>
            )}
          </div>
        </section>
      ))}
    </div>
  )}
  {closing && (
    <section class="page-closing section-wrap">
      <div><span class="eyebrow">{closing.eyebrow}</span><p>{closing.text}</p></div>
      <div class="page-closing-actions">
        {page.slug === 'about' && <a class="text-link" href="/corporate-philosophy/">Read our Corporate Philosophy <span aria-hidden="true">↗</span></a>}
        <a class="text-link" href="/contact/">Contact Elimu Africa <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  )}
</BaseLayout>
