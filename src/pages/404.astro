---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---
<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <section class="not-found section-wrap">
    <p class="eyebrow">404 · Page not found</p>
    <h1>This page is not here.</h1>
    <p>The address may have changed, or the page may no longer be available.</p>
    <div class="not-found-actions"><a class="button button-dark" href="/">Return to home</a><a class="text-link" href="/contact/">Contact Elimu Africa</a></div>
  </section>
</BaseLayout>
